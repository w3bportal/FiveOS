<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FingerTest — headless numerical harness for the finger retarget.

    Runs the REAL AnimRetarget on a real mocap FBX, FK-reconstructs the GTA
    hand from the emitted tracks, and scores it against the source: per-joint
    curl-angle correlation + a finger-crossing detector. Exists because the
    finger solver failed three times when judged by eyeball; this gives a
    number to iterate against before a human ever looks at the viewport.

    Mirrors dev/cli's link-include approach (single source of truth on
    src/Services). dev/ is gitignored — local tool only.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>fingertest</AssemblyName>
    <RootNamespace>FiveOS.FingerTest</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8620;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CodeWalker.Core">
      <HintPath>..\..\src\ydr-writer\lib\CodeWalker.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SharpDX">
      <HintPath>..\..\src\ydr-writer\lib\SharpDX.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SharpDX.Mathematics">
      <HintPath>..\..\src\ydr-writer\lib\SharpDX.Mathematics.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.8.1" />
    <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />
    <PackageReference Include="Geometry3Sharp.DotNet8.Unofficial" Version="1.0.0-d8" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Sentry" Version="6.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the retarget slice — the blanket Services include now drags in
         WPF-dependent files (ThemeAccent, PropPackTree, VideoTranscoder). -->
    <Compile Include="..\..\src\Services\AnimRetarget.cs" />
    <Compile Include="..\..\src\Services\GtaBoneTags.cs" />
    <Compile Include="..\..\src\Services\FosLogger.cs" />
    <Compile Include="..\..\src\Services\FeatureGate.cs" />
    <Compile Include="..\..\src\Services\UserSettings.cs" />
    <Compile Include="..\..\src\Services\RuntimeAssets.cs" />
    <Compile Include="..\..\src\Services\YcdAnimationBuilder.cs" />
    <Compile Include="..\..\src\Services\YcdPoseBuilder.cs" />
    <Compile Include="..\..\src\Services\YcdBoneSpaceConverter.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- RuntimeAssets' loose-folder fallback resolves Assets/Viewer beside the
         exe; only the reference skeletons are needed for a retarget. -->
    <None Include="..\..\src\Assets\Viewer\reference\**\*">
      <Link>Assets\Viewer\reference\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
