<ui:FluentWindow x:Class="FiveOS.Views.AddToPackDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Add to pack"
                 Width="430"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Add to pack" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="16,4,16,0">
            <TextBlock Text="Emote name"
                       FontSize="12"
                       Opacity="0.8"
                       Margin="0,0,0,6" />
            <ui:TextBox x:Name="NameBox"
                        FontFamily="Consolas"
                        FontSize="13"
                        MaxLength="40"
                        PlaceholderText="wave"
                        TextChanged="OnNameChanged" />
            <TextBlock x:Name="NameHint"
                       Text=""
                       FontSize="11"
                       Opacity="0.6"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <TextBlock Text="Menu label"
                       FontSize="12"
                       Opacity="0.8"
                       Margin="0,14,0,6" />
            <ui:TextBox x:Name="LabelBox"
                        FontSize="13"
                        MaxLength="60" />
            <TextBlock Text="Shown by the pack's list command and in the README. Rename it any time — only the emote name is locked once baked."
                       FontSize="11"
                       Opacity="0.5"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0,14,0,0">
                <TextBlock x:Name="BakeNote"
                           FontSize="11"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Text="The pose or animation on screen right now is baked into the pack when you click Add. Editing it afterwards won't change what's queued." />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,12,12">
            <ui:Button Content="Cancel" Appearance="Secondary" Padding="16,5" Margin="0,0,8,0" Click="OnCancel" />
            <ui:Button x:Name="OkButton" Content="Add" Appearance="Primary" Padding="16,5" Click="OnOk" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
