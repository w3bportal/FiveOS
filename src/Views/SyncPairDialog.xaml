<ui:FluentWindow x:Class="FiveOS.Views.SyncPairDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Synced emote — position the partner"
                 Width="430" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True">
    <Grid Margin="18,4,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Synced emote — position the partner"
                     ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="Everyone plays this clip. Each teal ped in the viewport is another player — pick a partner below, drag the sliders to place it, and Add more for group formations. Keep using the viewport while this window is open: orbit the camera, press Space to play, scrub the timeline. All characters animate together. Where a ghost stands is exactly where that accepting player will be placed in game."
                       FontSize="11" Foreground="#FF9A9A9A" TextWrapping="Wrap" Margin="0,0,0,14" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Partners" FontSize="11" Foreground="#FFBDBDBD" VerticalAlignment="Center" />
                <ui:Button x:Name="AddPartnerBtn" Grid.Column="1" Content="+ Add" FontSize="11" Padding="8,2"
                           Appearance="Secondary" Click="OnAddPartner"
                           ToolTip="Add another player to the formation (up to 5 partners). More than one partner exports as a standalone resource — RPEmotes' shared format is two players only." />
                <ui:Button x:Name="RemovePartnerBtn" Grid.Column="2" Content="Remove" FontSize="11" Padding="8,2"
                           Margin="6,0,0,0" Appearance="Secondary" IsEnabled="False" Click="OnRemovePartner"
                           ToolTip="Remove the selected partner." />
            </Grid>
            <StackPanel x:Name="PartnerChips" Orientation="Horizontal" Margin="0,0,0,12"
                        ToolTip="The partner bodies match the ped in the preview automatically. Preview only — any ped can accept in game." />

            <TextBlock Text="Install to" FontSize="11" Foreground="#FFBDBDBD" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="TargetRp" Content="RPEmotes" IsChecked="True" FontSize="12"
                             GroupName="SyncTarget" Checked="OnTargetChanged"
                             ToolTip="Install straight into your rpemotes-reborn resource." />
                <RadioButton x:Name="TargetFxr" Content="Standalone FiveM resource" FontSize="12"
                             Margin="18,0,0,0" GroupName="SyncTarget" Checked="OnTargetChanged"
                             ToolTip="A self-contained resource folder with its own /command, accept prompt and sync logic — no rpemotes needed." />
            </StackPanel>

            <TextBlock Text="Emote name" FontSize="11" Foreground="#FFBDBDBD" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" FontSize="12" MaxLength="40" Margin="0,0,0,10" />

            <TextBlock Text="Menu label" FontSize="11" Foreground="#FFBDBDBD" Margin="0,0,0,4" />
            <TextBox x:Name="LabelBox" FontSize="12" MaxLength="48" Margin="0,0,0,14" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" /><ColumnDefinition /><ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Front" FontSize="12" VerticalAlignment="Center" />
                <Slider x:Name="FrontSlider" Grid.Column="1" Minimum="0" Maximum="2.5" Value="1.0"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnOffsetChanged" />
                <TextBlock x:Name="FrontVal" Grid.Column="2" Text="1.00 m" FontSize="11"
                           Foreground="#FFBDBDBD" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" /><ColumnDefinition /><ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Side" FontSize="12" VerticalAlignment="Center" />
                <Slider x:Name="SideSlider" Grid.Column="1" Minimum="-1.5" Maximum="1.5" Value="0"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnOffsetChanged" />
                <TextBlock x:Name="SideVal" Grid.Column="2" Text="0.00 m" FontSize="11"
                           Foreground="#FFBDBDBD" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" /><ColumnDefinition /><ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Height" FontSize="12" VerticalAlignment="Center" />
                <Slider x:Name="HeightSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnOffsetChanged" />
                <TextBlock x:Name="HeightVal" Grid.Column="2" Text="0.00 m" FontSize="11"
                           Foreground="#FFBDBDBD" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" /><ColumnDefinition /><ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Heading" FontSize="12" VerticalAlignment="Center"
                           ToolTip="Rotation of the partner. 180° = the players face each other." />
                <Slider x:Name="HeadingSlider" Grid.Column="1" Minimum="0" Maximum="360" Value="180"
                        TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnOffsetChanged" />
                <TextBlock x:Name="HeadingVal" Grid.Column="2" Text="180°" FontSize="11"
                           Foreground="#FFBDBDBD" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tip: /e handshake-style spacing ≈ 0.9–1.2 m front."
                           FontSize="10" Foreground="#FF808080" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Cancel" Appearance="Secondary" MinWidth="88" Padding="10,6"
                               Margin="0,0,8,0" Click="OnCancel" />
                    <ui:Button x:Name="InstallBtn" Content="Install to RPEmotes" Appearance="Primary"
                               MinWidth="130" Padding="10,6" Click="OnInstall" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
