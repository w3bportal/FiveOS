<UserControl x:Class="FiveOS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:FiveOS.Views.Controls"
             xmlns:loc="clr-namespace:FiveOS.Markup"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="640">

    <UserControl.Resources>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="0,12,0,8" />
        </Style>

        <Style x:Key="ProviderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ProviderHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                CornerRadius="6"
                                Background="Transparent"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Indicator"
                                        Grid.Column="0"
                                        Width="3" Height="16"
                                        CornerRadius="2"
                                        Background="Transparent"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItemContent" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Margin="20,18,20,12">
                    <TextBlock Text="{loc:Loc Settings.Title}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="FiveOS" FontSize="11" Opacity="0.55" Margin="0,2,0,0" />
                </StackPanel>

                <ListBox x:Name="NavList"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="6,0,6,12"
                         SelectionChanged="OnNavChanged"
                         ItemContainerStyle="{StaticResource NavItemStyle}">
                    <ListBoxItem Tag="general" IsSelected="True"
                                 ToolTip="Discord Rich Presence toggle and UI language.">
                        <StackPanel Style="{StaticResource NavItemContent}">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Settings.General}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="api"
                                 ToolTip="API keys for Sketchfab (model downloads) and each AI provider (Meshy etc.). Keys are encrypted with Windows DPAPI in your user profile and only sent to the provider they belong to.">
                        <StackPanel Style="{StaticResource NavItemContent}">
                            <ui:SymbolIcon Symbol="Key24" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Settings.ApiKeys}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="output"
                                 ToolTip="Where converted resources land. Either a single folder (Downloads by default) or point straight at a FiveM server's resources folder for zero-copy installs.">
                        <StackPanel Style="{StaticResource NavItemContent}">
                            <ui:SymbolIcon Symbol="Server24" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Settings.Output}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="cache"
                                 ToolTip="See and clear local caches: temp work dirs, WebView2 leftovers, Emotes viewer bundles, and old runtime extracts under LocalAppData. Exports and API keys are never deleted.">
                        <StackPanel Style="{StaticResource NavItemContent}">
                            <ui:SymbolIcon Symbol="Storage24" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Settings.Cache}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="shortcuts"
                                 ToolTip="Every keyboard and mouse shortcut — viewport, timeline, clip editor.">
                        <StackPanel Style="{StaticResource NavItemContent}">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Shortcuts" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="about"
                                 ToolTip="Version info, credits, project links.">
                        <StackPanel Style="{StaticResource NavItemContent}">
                            <ui:SymbolIcon Symbol="Info24" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Settings.About}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1"
                      x:Name="ContentScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="36,28,36,32">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">

                <StackPanel x:Name="GeneralPage">
                    <TextBlock Text="{loc:Loc Settings.General}" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="{loc:Loc Settings.GeneralDesc}" />

                    <Border CornerRadius="6"
                            Padding="18,16"
                            Margin="0,12,0,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="20"
                                                   VerticalAlignment="Center" Opacity="0.85" />
                                    <TextBlock Text="{loc:Loc About.Discord}"
                                               Style="{StaticResource ProviderTitle}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource ProviderHelp}"
                                           Text="{loc:Loc About.DiscordDesc}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             x:Name="DiscordPresenceToggle"
                                             VerticalAlignment="Center"
                                             Margin="16,0,0,0"
                                             Checked="OnDiscordPresenceToggled"
                                             Unchecked="OnDiscordPresenceToggled"
                                             ToolTip="Show what you're doing in FiveOS (active tab, loaded model name) on your Discord profile via Rich Presence. Off by default; no data leaves your machine until you turn it on." />
                        </Grid>
                    </Border>

                    <Border CornerRadius="6"
                            Padding="18,16"
                            Margin="0,12,0,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" FontSize="20"
                                               VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Text="{loc:Loc Settings.DefaultEmotePed}"
                                           Style="{StaticResource ProviderTitle}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource ProviderHelp}"
                                       Text="{loc:Loc Settings.DefaultEmotePedDesc}" />
                            <ComboBox x:Name="DefaultEmotePedPicker"
                                      Margin="0,12,0,0"
                                      HorizontalAlignment="Stretch"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="OnDefaultEmotePedChanged"
                                      ToolTip="The GTA freemode ped loaded for a new Emotes tab.">
                                <ComboBoxItem Tag="male" Content="{loc:Loc Settings.PedMale}" />
                                <ComboBoxItem Tag="female" Content="{loc:Loc Settings.PedFemale}" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Control-rig weight. The posing handles are drawn heavy
                         so they read over the clay ped; these fade / thin them
                         when they bury the mesh. -->
                    <Border CornerRadius="6"
                            Padding="18,16"
                            Margin="0,12,0,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Accessibility24" FontSize="20"
                                               VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Text="Control rig appearance"
                                           Style="{StaticResource ProviderTitle}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource ProviderHelp}"
                                       Text="How heavy the coloured posing handles look on the ped in Emotes. Turn these down when the rig covers too much of the body — it stays clickable either way." />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Opacity" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="RigOpacityValue"
                                           FontFamily="Consolas" FontSize="10" Opacity="0.7"
                                           VerticalAlignment="Center" Text="100%" />
                            </Grid>
                            <Slider x:Name="RigOpacitySlider"
                                    Minimum="0.15" Maximum="1.0"
                                    SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Margin="0,2,0,0"
                                    ValueChanged="OnControlRigStyleChanged"
                                    ToolTip="Fade the posing handles back so you can see the ped underneath." />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Thickness" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="RigThicknessValue"
                                           FontFamily="Consolas" FontSize="10" Opacity="0.7"
                                           VerticalAlignment="Center" Text="100%" />
                            </Grid>
                            <Slider x:Name="RigThicknessSlider"
                                    Minimum="0.4" Maximum="1.6"
                                    SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Margin="0,2,0,0"
                                    ValueChanged="OnControlRigStyleChanged"
                                    ToolTip="Thin down the handle outlines." />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="6"
                            Padding="18,16"
                            Margin="0,12,0,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="20"
                                               VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Text="{loc:Loc Language.Picker}"
                                           Style="{StaticResource ProviderTitle}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource ProviderHelp}"
                                       Text="{loc:Loc Language.Desc}" />
                            <ComboBox x:Name="LanguagePicker"
                                      Margin="0,12,0,0"
                                      HorizontalAlignment="Stretch"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Code"
                                      SelectionChanged="OnLanguageChanged"
                                      ToolTip="UI language for FiveOS itself (menus, dialogs, sidebar labels). Doesn't change anything in the assets you export." />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="6"
                            Padding="18,16"
                            Margin="0,12,0,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Color24" FontSize="20"
                                               VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Text="Accent color"
                                           Style="{StaticResource ProviderTitle}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource ProviderHelp}"
                                       Text="Highlight colour for selection, primary buttons, tabs, timeline playhead, and the viewer HUD. Blue is the default." />
                            <ItemsControl x:Name="AccentSwatches"
                                          Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,10,10"
                                                Padding="0"
                                                Width="36" Height="36"
                                                Cursor="Hand"
                                                Click="OnAccentSwatchClick"
                                                ToolTip="{Binding Name}"
                                                Tag="{Binding Hex}"
                                                BorderThickness="2"
                                                BorderBrush="{Binding BorderBrush}"
                                                Background="{Binding Fill}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="chrome"
                                                            Width="36" Height="36"
                                                            CornerRadius="4"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            SnapsToDevicePixels="True" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="OutputPage" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc Settings.Output}" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="{loc:Loc Settings.OutputDesc}" />

                    <Border CornerRadius="6"
                            Padding="18,16"
                            Margin="0,0,0,12"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderArrowRight24" FontSize="20"
                                               VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Text="{loc:Loc Settings.SingleFolder}"
                                           Style="{StaticResource ProviderTitle}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource ProviderHelp}"
                                       Margin="0,8,0,0"
                                       Text="{loc:Loc Settings.SingleFolderDesc}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            x:Name="SingleOutputBox"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            PlaceholderText="{loc:Loc Settings.SingleFolderPlaceholder}"
                                            VerticalAlignment="Center"
                                            LostFocus="OnSingleOutputCommit"
                                            KeyDown="OnSingleOutputKeyDown"
                                            ToolTip="Folder where converted resources land when you're NOT pointing at a server. Defaults to your Downloads folder." />
                                <ui:Button Grid.Column="1"
                                           Content="{loc:Loc Common.Browse}"
                                           Appearance="Secondary"
                                           Padding="14,6"
                                           Margin="8,0,0,0"
                                           Click="OnSingleOutputBrowse"
                                           ToolTip="Pick a folder via Explorer." />
                                <ui:Button Grid.Column="2"
                                           Content="{loc:Loc Common.Reset}"
                                           Appearance="Secondary"
                                           Padding="14,6"
                                           Margin="6,0,0,0"
                                           Click="OnSingleOutputReset"
                                           ToolTip="Restore the default (your Windows Downloads folder)." />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="6"
                            Padding="18,16"
                            Margin="0,0,0,12"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Server24" FontSize="20"
                                                   VerticalAlignment="Center" Opacity="0.85" />
                                    <TextBlock Text="{loc:Loc Settings.ServerFolder}"
                                               Style="{StaticResource ProviderTitle}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        x:Name="ServerStatusPill"
                                        Style="{StaticResource StatusPill}"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                    <TextBlock x:Name="ServerStatusText"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{loc:Loc Settings.Off}"
                                               Opacity="0.7" />
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource ProviderHelp}"
                                       Margin="0,8,0,0"
                                       Text="{loc:Loc Settings.ServerFolderDesc}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            x:Name="ServerFolderBox"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            PlaceholderText="{loc:Loc Settings.ServerFolderPlaceholder}"
                                            VerticalAlignment="Center"
                                            LostFocus="OnServerFolderCommit"
                                            KeyDown="OnServerFolderKeyDown"
                                            ToolTip="Point this at a FiveM server's resources folder and converted props drop straight in — no manual copy step. Leave empty to use the single-folder output above." />
                                <ui:Button Grid.Column="1"
                                           Content="{loc:Loc Common.Browse}"
                                           Appearance="Secondary"
                                           Padding="14,6"
                                           Margin="8,0,0,0"
                                           Click="OnServerFolderBrowse"
                                           ToolTip="Pick the server's resources folder via Explorer." />
                                <ui:Button Grid.Column="2"
                                           Content="{loc:Loc Common.Clear}"
                                           Appearance="Secondary"
                                           Padding="14,6"
                                           Margin="6,0,0,0"
                                           Click="OnServerFolderClear"
                                           ToolTip="Disconnect from any server folder — exports go back to the single-folder destination above." />
                            </Grid>

                            <TextBlock Text="{loc:Loc Settings.Layout}"
                                       Style="{StaticResource GroupHeader}"
                                       Margin="0,16,0,4" />
                            <RadioButton x:Name="ServerLayoutShared"
                                         GroupName="ServerLayoutGroup"
                                         Padding="6,4"
                                         Click="OnServerLayoutChanged"
                                         ToolTip="Merge every converted prop's stream files + fxmanifest into ONE shared resource folder. Pro: server.cfg only has one ensure line. Con: harder to disable individual props later — you'd have to delete stream files.">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Settings.LayoutShared}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{loc:Loc Settings.LayoutSharedDesc}"
                                               FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ServerLayoutPerAsset"
                                         GroupName="ServerLayoutGroup"
                                         Padding="6,4"
                                         Margin="0,6,0,0"
                                         Click="OnServerLayoutChanged"
                                         ToolTip="Each converted prop ships as its own resource folder. Pro: easy to disable/remove props by deleting their folder. Con: server.cfg needs one ensure line per prop.">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Settings.LayoutPerAsset}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{loc:Loc Settings.LayoutPerAssetDesc}"
                                               FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ApiKeysPage" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc Settings.ApiKeys}" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="{loc:Loc Settings.ApiKeysDesc}" />

                    <Border x:Name="SketchfabCard"
                            CornerRadius="6"
                            Padding="18,16"
                            Margin="0,0,0,12"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Cube24" FontSize="20" VerticalAlignment="Center" Opacity="0.85" />
                                    <TextBlock Text="Sketchfab"
                                               Style="{StaticResource ProviderTitle}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        x:Name="SketchfabPill"
                                        Style="{StaticResource StatusPill}"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                    <TextBlock x:Name="SketchfabStatus"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{loc:Loc Settings.NotSaved}"
                                               Opacity="0.7" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="SketchfabHelp"
                                       Style="{StaticResource ProviderHelp}"
                                       Margin="0,8,0,0">
                                <Run Text="{loc:Loc Settings.SketchfabHelpRun1}" />
                                <Hyperlink Click="OnOpenSketchfabSite">sketchfab.com/settings/password</Hyperlink>
                                <Run Text="{loc:Loc Settings.SketchfabHelpRun2}" />
                            </TextBlock>

                            <Grid x:Name="SketchfabEditRow" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox Grid.Column="0"
                                             x:Name="SketchfabBox"
                                             FontFamily="Consolas"
                                             FontSize="13"
                                             Padding="8,6"
                                             VerticalAlignment="Center"
                                             ToolTip="Paste your Sketchfab API token here. Get one from sketchfab.com/settings/password — stored encrypted via Windows DPAPI, never logged or sent anywhere except sketchfab.com." />
                                <ui:Button Grid.Column="1"
                                           Content="{loc:Loc Common.Save}"
                                           Appearance="Primary"
                                           Padding="14,6"
                                           Margin="8,0,0,0"
                                           Click="OnSaveSketchfab"
                                           ToolTip="Encrypt the token and save it. Subsequent Sketchfab URL imports authenticate automatically." />
                                <ui:Button Grid.Column="2"
                                           x:Name="SketchfabCancel"
                                           Content="{loc:Loc Common.Cancel}"
                                           Appearance="Secondary"
                                           Padding="14,6"
                                           Margin="6,0,0,0"
                                           Visibility="Collapsed"
                                           Click="OnCancelSketchfab"
                                           ToolTip="Abandon the edit and keep the previously-saved token." />
                            </Grid>

                            <StackPanel x:Name="SketchfabSavedRow"
                                        Orientation="Horizontal"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                <ui:Button Content="{loc:Loc Settings.ReplaceKey}"
                                           Appearance="Secondary"
                                           Padding="14,6"
                                           Click="OnEditSketchfab"
                                           ToolTip="Replace the saved token with a new one — useful after regenerating the token on Sketchfab.">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Edit24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="{loc:Loc Common.Clear}"
                                           Appearance="Secondary"
                                           Padding="14,6"
                                           Margin="8,0,0,0"
                                           Click="OnClearSketchfab"
                                           ToolTip="Remove the saved token. Sketchfab URL imports will fail until you save a new one.">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:Loc Settings.AiProviders}"
                               Style="{StaticResource GroupHeader}" />

                    <ItemsControl x:Name="AiProviderList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ctrl:ApiKeyCard Provider="{Binding}"
                                                 Margin="0,0,0,12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="CachePage" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc Settings.Cache}" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="{loc:Loc Settings.CacheDesc}" />

                    <Border CornerRadius="6"
                            Padding="18,16"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Storage24" FontSize="20" VerticalAlignment="Center" Opacity="0.85" />
                                    <TextBlock Text="{loc:Loc Settings.CacheSize}"
                                               Style="{StaticResource ProviderTitle}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CacheStatus"
                                           Style="{StaticResource ProviderHelp}"
                                           Text="{loc:Loc Settings.Calculating}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       x:Name="CacheClearButton"
                                       Content="{loc:Loc Settings.ClearCache}"
                                       Appearance="Secondary"
                                       Padding="14,6"
                                       VerticalAlignment="Center"
                                       Click="OnClearCache"
                                       ToolTip="Wipe temp caches, stale Emotes viewer bundles, and old %LOCALAPPDATA%\FiveOS\runtime extracts. Exports and secrets are never touched. Restart and clear again if some folders were locked while the app was open.">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ShortcutsPage" Visibility="Collapsed">
                    <StackPanel.Resources>
                        <Style x:Key="KbGroup" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="#FFE8E8E8" />
                            <Setter Property="Margin" Value="0,18,0,8" />
                        </Style>
                        <Style x:Key="KbKey" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="#FFE8E8E8" />
                            <Setter Property="Background" Value="#FF2E2E34" />
                            <Setter Property="Padding" Value="8,3" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="KbDesc" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="#FFB8B8B8" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Margin" Value="14,0,0,0" />
                        </Style>
                    </StackPanel.Resources>

                    <TextBlock Text="Shortcuts" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Keyboard and mouse shortcuts across the app. Emotes viewport shortcuts apply while the 3D view has focus." />

                    <TextBlock Text="Emotes viewport" Style="{StaticResource KbGroup}" />
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Space" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Play / pause" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="← →" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Step one frame (hold Shift for ×10)" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="↑ ↓" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Previous / next keyframe" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Home  End" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Jump to start / end" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="K" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Add keyframe at the playhead" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Del" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Delete the keyframe at the playhead" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Shift+Del" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Clear all — clips, keyframes and pose (confirmed)" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="M" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Mirror pose left ↔ right" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="W  E  R" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Gizmo mode: move / rotate / scale" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="F" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Frame the selected bone (frame the rig when nothing is selected)" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="/" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Toggle looped playback" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Shift+X / Y / Z" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Axis lock while dragging a bone" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Ctrl+Z / Ctrl+Y" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Undo / redo" Style="{StaticResource KbDesc}" /></Grid>

                    <TextBlock Text="Viewport navigation" Style="{StaticResource KbGroup}" />
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Middle mouse" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Orbit" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Shift+Middle mouse" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Pan" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Scroll wheel" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Zoom" Style="{StaticResource KbDesc}" /></Grid>

                    <TextBlock Text="Timeline" Style="{StaticResource KbGroup}" />
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Scroll wheel" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Zoom at the cursor" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Shift/Ctrl+wheel" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Pan the visible window" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Drag a lane bar" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Slide the animation in time (endpoint dots trim; Shift bypasses frame snap)" Style="{StaticResource KbDesc}" /></Grid>

                    <TextBlock Text="Motion clip editor" Style="{StaticResource KbGroup}" />
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Space" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Play / pause the clip" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="← →" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Step one frame" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Home  End" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Jump to trim start / end" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="I  O" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Set trim start / end at the playhead" Style="{StaticResource KbDesc}" /></Grid>
                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Double-click crop" Style="{StaticResource KbKey}" /><TextBlock Grid.Column="1" Text="Reset the crop box to the full frame" Style="{StaticResource KbDesc}" /></Grid>
                </StackPanel>

                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc Settings.About}" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="{loc:Loc About.PageDesc}" />

                    <Border CornerRadius="6"
                            Padding="18,16"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Loc About.Version}" Style="{StaticResource ProviderTitle}" />
                                    <TextBlock x:Name="AboutVersion"
                                               Style="{StaticResource ProviderHelp}"
                                               Text="—" />
                                </StackPanel>
                                <ui:Button Grid.Column="1"
                                           Content="{loc:Loc About.OpenCredits}"
                                           Appearance="Secondary"
                                           Padding="14,6"
                                           VerticalAlignment="Center"
                                           Click="OnOpenCredits"
                                           ToolTip="Open the full About window with version, contributors, and project links." />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
